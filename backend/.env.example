# ── Server ────────────────────────────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=fc_user
POSTGRES_PASSWORD=fc_password
POSTGRES_DATABASE=flip_chat
POSTGRES_SSLMODE=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=fc_password
REDIS_DB=0

# Presence TTL — how long a user appears online after the last heartbeat.
# Must be longer than the WebSocket heartbeat interval (default: 30s).
PRESENCE_TTL=35s

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=fc_user
MINIO_SECRET_KEY=fc_password
MINIO_BUCKET=flipchat
MINIO_USE_SSL=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Replace with a long random secret before deploying.
# Generate one with: openssl rand -hex 64
JWT_SECRET=change_this_to_a_very_long_random_secret_key

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h
